      }
    },
    
    "response_format": {
      "success_response": {
        "success": true,
        "message": "Flash Trade任务创建并启动成功",
        "task_id": "flash-trade-1234567890",
        "affected_nodes": ["node_001", "node_002"],
        "affected_accounts": ["account1", "account2"]
      },
      "error_response": {
        "success": false,
        "message": "错误描述信息"
      }
    },
    
    "parameter_descriptions": {
      "node_id": "目标节点ID，空字符串表示所有在线节点",
      "account_id": "目标账号ID，空字符串表示节点的所有账号",
      "token_address": "代币合约地址 (必填)",
      "usdt_amount": "USDT交易金额，必须大于0 (必填)",
      "base_asset": "基础资产名称，默认ALPHA_251",
      "target_volume": "目标交易量，必须大于0 (必填)",
      "auto_loop": "是否启用自动循环交易",
      "price_precision": "价格精度位数，1-15之间",
      "chain_id": "区块链ID，56=BSC，CT_501=Solana (必填)",
      "price_mode": "价格模式，limit/market/combined/auto (必填)",
      "force_start": "是否强制启动，忽略冲突检查",
      "stop_existing": "是否停止现有冲突任务"
    },
    
    "usage_notes": {
      "master_node": "确保Master节点运行在localhost:28080",
      "slave_nodes": "确保Slave节点已连接并在线",
      "flash_trade_service": "确保Flash Trade服务运行在各节点的8080端口",
      "network": "确保网络连接正常",
      "parameters": "必填参数不能为空，数值参数必须大于0",
      "price_modes": "推荐买单使用market模式以获得最高成功率"
    }
  }
