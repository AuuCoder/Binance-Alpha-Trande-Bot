        "curl_command": "curl -X POST http://localhost:28080/api/flash-trade/start -H 'Content-Type: application/json' -d '{\"node_id\":\"\",\"account_id\":\"\",\"token_address\":\"0x6cfffa5bfd4277a04d83307feedfe2d18d944dd2\",\"usdt_amount\":100,\"base_asset\":\"ALPHA_251\",\"target_volume\":1000,\"auto_loop\":true,\"price_precision\":8,\"chain_id\":\"56\",\"price_mode\":\"limit\",\"force_start\":true,\"stop_existing\":true}'"
