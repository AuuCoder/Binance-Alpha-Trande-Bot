{
  "flash_trade_task_examples": {
    "description": "Flash Trade 分布式任务下发格式示例",
    "version": "v1.0",
    "supported_chains": {
      "BSC": "56",
      "Solana": "CT_501"
    },
    "supported_price_modes": {
      "limit": "限价模式 - 获取限价订单价格",
      "market": "市价模式 - 获取真实成交价格 (推荐买单使用)",
      "combined": "综合模式 - 获取综合价格信息",
      "auto": "自动模式 - 智能选择最佳模式"
    },
    
    "examples": {
      "bsc_market_normal": {
        "name": "BSC链 - Market模式 - 正常交易",
        "description": "BSC链上使用Market价格模式的标准Flash Trade任务",
        "request": {
          "node_id": "",
          "account_id": "",
          "token_address": "0xa2be3e48170a60119b5f0400c65f65f3158fbeee",
          "usdt_amount": 100.0,
          "base_asset": "ALPHA_251",
          "target_volume": 1000.0,
          "auto_loop": true,
          "price_precision": 8,
          "chain_id": "56",
          "price_mode": "market",
          "force_start": true,
          "stop_existing": true
        },
        "curl_command": "curl -X POST http://localhost:28080/api/flash-trade/start -H 'Content-Type: application/json' -d '{\"node_id\":\"\",\"account_id\":\"\",\"token_address\":\"0xa2be3e48170a60119b5f0400c65f65f3158fbeee\",\"usdt_amount\":100,\"base_asset\":\"ALPHA_251\",\"target_volume\":1000,\"auto_loop\":true,\"price_precision\":8,\"chain_id\":\"56\",\"price_mode\":\"market\",\"force_start\":true,\"stop_existing\":true}'"
      },
      
      "bsc_limit_normal": {
